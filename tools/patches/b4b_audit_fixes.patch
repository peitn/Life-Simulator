@@@NEW
## B4b: má postava (jméno uzlu) hráče – připojeného, nebo drženého v době na návrat?
func sim_has_player(sim_node: String) -> bool:
	if sim_node == "":
		return false
	for pid in players:
		if String(players[pid].get("sim", "")) == sim_node:
			return true
	for hk in _held:
		if String(_held[hk].get("sim", "")) == sim_node:
			return true
	return false


