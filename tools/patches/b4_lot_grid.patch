	walls.erase(int(wid))
	funds = mini(funds + refund, MAX_FUNDS)
	_log(now, "unwall", "", refund, actor)
	revision += 1
	if gone > 0:
		rebuild()
	return {"ok": true, "reason": "", "refund": refund, "openings_removed": gone}
