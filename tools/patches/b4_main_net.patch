func _wall_key(w: Dictionary) -> String:
	var k := "%d,%d,%d,%d" % [int(w["x0"]), int(w["z0"]), int(w["x1"]), int(w["z1"])]
	if lot != null and w.has("wid"):
		for o in lot.openings_of(int(w["wid"])):
			k += "|%d:%s@%d" % [int(o["oid"]), String(o["kind"]), int(o["at"])]
	return k
