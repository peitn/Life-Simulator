Header
 Mesh DB "." "."
End
Simulation
 Max Output Level = 4
 Coordinate System = Cartesian 2D
 Simulation Type = Steady State
 Steady State Max Iterations = 1
 Output Intervals = 1
End
Body 1
 Name = "passive muscle"
 Equation = 1
 Material = 1
End
Body 2
 Name = "passive adipose"
 Equation = 1
 Material = 2
End
Equation 1
 Active Solvers(2) = 1 2
 Plane Stress = Logical True
End
Solver 1
 Equation = "Linear elasticity"
 Procedure = "StressSolve" "StressSolver"
 Variable = -dofs 2 Displacement
 Calculate Stresses = Logical True
 Linear System Solver = Direct
 Linear System Direct Method = Banded
 Steady State Convergence Tolerance = 1.0e-9
End
Solver 2
 Exec Solver = After Simulation
 Equation = "ResultOutput"
 Procedure = "ResultOutputSolve" "ResultOutputSolver"
 Output File Name = case
 Vtu Format = Logical True
 Binary Output = Logical False
 Single Precision = Logical False
End
Material 1
 Name = "passive muscle surrogate"
 Youngs Modulus = 30000.0
 Poisson Ratio = 0.35
 Density = 1050
End
Material 2
 Name = "passive adipose surrogate"
 Youngs Modulus = 5000.0
 Poisson Ratio = 0.35
 Density = 900
End
Boundary Condition 1
 Name = "fixed core-facing left"
 Target Boundaries(1) = 4
 Displacement 1 = 0
 Displacement 2 = 0
End
Boundary Condition 2
 Name = "100 Pa traction on skin-facing tissue"
 Target Boundaries(1) = 2
 Force 1 = -100.0
End