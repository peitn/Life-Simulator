extends "res://tests/test_base.gd"
## No FCCS, no playable SH. Broad sensory sensitivity and explicit/perceived
## rejection have independent predisposition, dynamic reactions and support.
const Schema := preload("res://scripts/character/character_schema.gd")
const Validator := preload("res://scripts/character/character_validator.gd")
const Codec := preload("res://scripts/character/character_codec.gd")
const CharacterData := preload("res://scripts/character/character_data.gd")
const PM := preload("res://scripts/psyche/psyche_model.gd")
const Sensory := preload("res://scripts/sim/sensory_profile.gd")
const Rejection := preload("res://scripts/sim/rejection_response.gd")
const Agent := preload("res://scripts/sim/sim_agent.gd")
const Actions := preload("res://scripts/sim/action_library.gd")

func _ready() -> void:
	section("Schema and privacy")
	check(Schema.PSYCHE_SLIDERS.has("rejection_reactivity"), "Emotional response to rejection has its own slider")
	check(Schema.PSYCHE_SLIDERS.has("social_threat") and Schema.PSYCHE_SLIDERS.has("threat_sensitivity"), "Expectation and threat appraisal remain independent")
	check(String(Schema.PSYCHE_SLIDERS.get("sensory_sensitivity", "")).contains("Hypersenzitivita"), "Existing sensory slider is relabelled hypersensitivity without data breakage")
	var d := Schema.defaults()
	d["v"] = Schema.VERSION
	d["uid"] = CharacterData.new_uid()
	d["identity"]["first_name"] = "Alex"
	d["personality"]["traits"] = ["optimista"]
	d["mind"]["dispositions"] = {"rejection_reactivity": 0.95, "social_threat": 0.7,
		"threat_sensitivity": 0.35, "sensory_sensitivity": 0.9, "hypervigilance": 0.1}
	var v := Validator.validate(d)
	check(bool(v["ok"]), "Server accepts independent optional mental dimensions", str(v["errors"]))
	var serialized := Codec.from_json(Codec.to_json(v["data"]))
	check(bool(serialized["ok"]) and absf(float(serialized["data"]["mind"]["dispositions"]["rejection_reactivity"]) - 0.95) < 0.001, "Round-trip preserves emotional reactivity")
	var old_v8 := d.duplicate(true)
	old_v8["mind"]["dispositions"].erase("rejection_reactivity")
	check(bool(Validator.validate(old_v8)["ok"]), "Old schema-v8 saves without the new slider remain accepted")
	var malformed := d.duplicate(true)
	malformed["mind"]["dispositions"]["rejection_reactivity"] = INF
	check(not Validator.validate(malformed)["ok"], "Non-finite reactivity rejected")
	malformed = d.duplicate(true)
	malformed["mind"]["dispositions"]["sensory_sensitivity"] = 1.1
	check(not Validator.validate(malformed)["ok"], "Out-of-range hypersensitivity rejected")
	var cd := CharacterData.create()
	cd.set_from_dict(v["data"])
	check(not cd.public_snapshot().has("mind"), "Rejection traits and SH-related states are never in public character data")
	var D: Dictionary = PM.compute(cd.to_dict(), {"individual": false})["D"]
	check(absf(float(D["rejection_reactivity"]) - 0.95) < 0.001 and absf(float(D["sensory_sensitivity"]) - 0.9) < 0.001, "Psychological model consumes both sliders")
	section("Broad hypersensitivity; older noise profile remains")
	var base := Sensory.new()
	var hypo := Sensory.new()
	var hyper := Sensory.new()
	for s in [base, hypo, hyper]:
		s.setup([], {}, 73)
	hypo.configure({"sensory_sensitivity": 0.0})
	hyper.configure({"sensory_sensitivity": 1.0})
	check(hypo.noise_factor() < base.noise_factor() and hyper.noise_factor() > base.noise_factor(), "Sound response scales with hypersensitivity")
	check(hypo.crowd_factor() < base.crowd_factor() and hyper.crowd_factor() > base.crowd_factor(), "Crowd response scales with hypersensitivity")
	check(hypo.sensory_factor("touch") < hyper.sensory_factor("touch"), "Tactile channel available for future events")
	check(hypo.sensory_factor("bright_light") < hyper.sensory_factor("bright_light"), "Bright-light channel available for future events")
	check(absf(base.noise_factor() - base.noise_sens) < 0.00001, "Neutral hypersensitivity keeps existing noise baseline")
	var noisy_before := hyper.noise_factor()
	hyper.expose_noise(10.0)
	check(hyper.noise_factor() < noisy_before and absf(hyper.crowd_factor() - base.crowd_factor()) > 0.01, "Noise habituation preserved independently of crowd sensitivity")
	check(absf(hyper.joy_sens - base.joy_sens) < 0.00001, "Hypersensitivity does not alter enjoyment sensitivity")
	section("Rejection: expectation versus emotional response")
	var sensitive := Rejection.new()
	var resilient := Rejection.new()
	sensitive.configure({"rejection_reactivity": 0.95})
	resilient.configure({"rejection_reactivity": 0.05})
	var hit_high := sensitive.on_cue("real", 0.9, 0.8)
	var hit_low := resilient.on_cue("real", 0.9, 0.8)
	check(float(hit_high["distress_added"]) > float(hit_low["distress_added"]) * 2.0, "Emotional response differs at identical appraisal")
	var perceived := Rejection.new()
	var real := Rejection.new()
	perceived.configure({"rejection_reactivity": 0.9})
	real.configure({"rejection_reactivity": 0.9})
	check(float(perceived.on_cue("perceived", 0.9, 0.8)["distress_added"]) < float(real.on_cue("real", 0.9, 0.8)["distress_added"]), "Ambiguous perception is weaker than actual rejection")
	var supported := Rejection.new()
	supported.configure({"rejection_reactivity": 0.9})
	check(float(supported.on_cue("real", 0.9, 0.8, 1.0, 0.9)["distress_added"]) < float(real.distress), "Support and regulation buffer emotional response")
	var before := sensitive.distress
	sensitive.tick(600.0, true, 0.8, 20.0, 0.8, false)
	check(sensitive.distress < before * 0.25, "Time, sleep and support allow recovery")
	check(not sensitive.needs_support(), "Recovered state does not retain forced need for help")
	var concerning := Rejection.new()
	concerning.configure({"rejection_reactivity": 1.0})
	for i in 20:
		concerning.on_cue("real", 1.0, 0.95, 0.0, 0.15)
	concerning.update_concern(90.0, 0.1, 0.0, false)
	check(not concerning.concern and not concerning.private_status().has("safety_concern"), "Self-harm concern is hidden and disabled by default")
	concerning.update_concern(90.0, 0.1, 0.0, true)
	check(concerning.concern and bool(concerning.private_status(true)["safety_concern"]), "Opt-in sensitive setting can show private need-for-care flag")
	concerning.tick(1500.0, true, 1.0, 15.0, 0.9, true)
	check(not concerning.concern, "Protective context and recovery resolve concern")
	check(Actions.get_action("self_harm").is_empty(), "Self-harm cannot be played as an action")
	section("Runtime, presentation toggle and noise independence")
	var actor := Node3D.new()
	actor.set_script(Agent)
	actor.setup("Alex", "m", ["optimista"], Color.WHITE, 421, null)
	var noise_before: float = actor.sensory.noise_sens
	actor.apply_character_private(cd.to_dict())
	check(absf(actor.rejection.reactivity - 0.95) < 0.001, "Runtime consumes emotion slider")
	check(absf(actor.sensory.hypersensitivity - 0.9) < 0.001, "Runtime consumes broad hypersensitivity")
	check(absf(actor.sensory.noise_sens - noise_before) < 0.00001, "Existing individual auditory baseline intact")
	var partner := Node3D.new()
	partner.set_script(Agent)
	partner.setup("Robin", "n", ["optimista"], Color.WHITE, 422, null)
	var actual: Dictionary = actor._on_rejection_cue("real", partner)
	check(float(actual.get("distress_added", 0.0)) > 0.0, "Real rejection updates private emotional state")
	var old_alert: float = actor.rejection.distress
	var imagined: Dictionary = actor._on_rejection_cue("perceived", partner, 0.75)
	check(float(imagined.get("distress_added", 0.0)) > 0.0 and actor.rejection.distress > old_alert, "Perceived rejection is modelled as a subjective cue")
	var initial_difficulty: float = actor.perceived_rejection_chance()
	actor.vigilance.social_threat = 0.1
	check(actor.perceived_rejection_chance() < initial_difficulty, "Likelihood of misinterpreting a reply depends on expectation, not emotional reactivity")
	check(not actor.private_rejection_status().has("safety_concern"), "Detached actor never exposes the opt-in concern")
	# Full runtime content toggles; private concern must be invisible by default.
	var gs = get_node("/root/GameSettings")
	var old_mode: String = String(gs.get_value("mental_health"))
	var old_opt_in: bool = bool(gs.get_value("sh_ed_topics"))
	var old_thoughts: int = int(gs.get_value("intrusive_thoughts"))
	gs.set_value("mental_health", "full", false)
	gs.set_value("sh_ed_topics", false, false)
	add_child(actor)
	actor.rejection.distress = 0.9
	actor.mental.stress = 90.0
	actor.mental.support = 0.0
	actor.rejection.tick(0.0, false, 0.0, 90.0, 0.2, actor._allows_rejection_risk())
	check(not actor.private_rejection_status().has("safety_concern"), "Server default hides private SH-related concern")
	gs.set_value("sh_ed_topics", true, false)
	actor.rejection.tick(0.0, false, 0.0, 90.0, 0.2, actor._allows_rejection_risk())
	check(bool(actor.private_rejection_status().get("safety_concern", false)), "Server opt-in enables concern without automatic action")
	check(not actor._build_detail().has("safety_concern") and not actor._build_detail().get("mind", {}).has("safety_concern"), "No concern flag broadcast through net_detail")
	gs.set_value("mental_health", "muted", false)
	actor.rejection.tick(0.0, false, 0.0, 90.0, 0.2, actor._allows_rejection_risk())
	check(not actor.private_rejection_status().has("safety_concern"), "Muted mental-health mode blocks sensitive flag")
	gs.set_value("mental_health", "full", false)
	var p_before: float = actor.perceived_rejection_chance()
	gs.set_value("intrusive_thoughts", 0, false)
	check(absf(actor.perceived_rejection_chance() - p_before) < 0.0001, "Ambiguous-cue interpretation independent from text visibility")
	gs.set_value("intrusive_thoughts", old_thoughts, false)
	gs.set_value("sh_ed_topics", old_opt_in, false)
	gs.set_value("mental_health", old_mode, false)
	var ui: Control = load("res://scripts/ui/personality_slider_editor.gd").new()
	ui.load_character(cd)
	ui._build()
	var readout := Label.new()
	ui._on_slider(0.82, "dispositions", "rejection_reactivity", readout)
	check(absf(float(ui.export_data()["mind"]["dispositions"]["rejection_reactivity"]) - 0.82) < 0.001, "Reusable editor persists rejection slider")
	readout.free()
	ui.free()
	actor.free()
	partner.free()
	finish("test_rejection_hypersensitivity")
